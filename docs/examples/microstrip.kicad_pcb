(kicad_pcb
	(version 20240108)
	(generator "kicad_fdtd example")
	(general
		(thickness 1.6)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(31 "B.Cu" signal)
		(44 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 1"
				(type "core")
				(thickness 0.2)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
			)
			(layer "B.Cu"
				(type "copper")
				(thickness 0.035)
			)
		)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "/SIG")
	(net 3 "/CLK_P")
	(net 4 "/CLK_N")
	(footprint "example:port"
		(layer "F.Cu")
		(at 104 55)
		(property "Reference" "P1" (at 0 0 0) (layer "F.SilkS"))
		(property "Value" "port" (at 0 0 0) (layer "F.Fab"))
		(pad "1" smd rect (at 0 0) (size 0.4 0.4) (layers "F.Cu") (net 2 "/SIG"))
	)
	(footprint "example:port"
		(layer "F.Cu")
		(at 116 55)
		(property "Reference" "P2" (at 0 0 0) (layer "F.SilkS"))
		(property "Value" "port" (at 0 0 0) (layer "F.Fab"))
		(pad "1" smd rect (at 0 0) (size 0.4 0.4) (layers "F.Cu") (net 2 "/SIG"))
	)
	(footprint "example:pair"
		(layer "F.Cu")
		(at 104 52)
		(property "Reference" "D1" (at 0 0 0) (layer "F.SilkS"))
		(property "Value" "pair" (at 0 0 0) (layer "F.Fab"))
		(pad "1" smd rect (at 0 -0.4) (size 0.35 0.35) (layers "F.Cu") (net 3 "/CLK_P"))
		(pad "2" smd rect (at 0 0.4) (size 0.35 0.35) (layers "F.Cu") (net 4 "/CLK_N"))
	)
	(footprint "example:pair"
		(layer "F.Cu")
		(at 116 52)
		(property "Reference" "D2" (at 0 0 0) (layer "F.SilkS"))
		(property "Value" "pair" (at 0 0 0) (layer "F.Fab"))
		(pad "1" smd rect (at 0 -0.4) (size 0.35 0.35) (layers "F.Cu") (net 3 "/CLK_P"))
		(pad "2" smd rect (at 0 0.4) (size 0.35 0.35) (layers "F.Cu") (net 4 "/CLK_N"))
	)
	(segment (start 104 55) (end 116 55) (width 0.36) (layer "F.Cu") (net 2))
	(segment (start 104 51.6) (end 116 51.6) (width 0.3) (layer "F.Cu") (net 3))
	(segment (start 104 52.4) (end 116 52.4) (width 0.3) (layer "F.Cu") (net 4))
	(gr_rect (start 100 48) (end 120 60) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(zone
		(net 1)
		(net_name "GND")
		(layer "B.Cu")
		(hatch edge 0.5)
		(connect_pads (clearance 0.3))
		(min_thickness 0.25)
		(fill yes)
		(polygon (pts (xy 100 48) (xy 120 48) (xy 120 60) (xy 100 60)))
		(filled_polygon (layer "B.Cu") (pts (xy 100 48) (xy 120 48) (xy 120 60) (xy 100 60)))
	)
)
