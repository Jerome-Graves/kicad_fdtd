(kicad_pcb
	(version 20240108)
	(generator "kicad_fdtd example")
	(general
		(thickness 1.6)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(31 "B.Cu" signal)
		(44 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 1"
				(type "core")
				(thickness 1.53)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
			)
			(layer "B.Cu"
				(type "copper")
				(thickness 0.035)
			)
		)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "/ANT")
	(footprint "example:port"
		(layer "F.Cu")
		(at 103 125)
		(property "Reference" "P1" (at 0 0 0) (layer "F.SilkS"))
		(property "Value" "port" (at 0 0 0) (layer "F.Fab"))
		(pad "1" smd rect (at 0 0) (size 2.9 2.9) (layers "F.Cu") (net 2 "/ANT"))
	)
	(segment (start 103 125) (end 122.5 125) (width 2.9) (layer "F.Cu") (net 2))
	(zone
		(net 2)
		(net_name "/ANT")
		(layer "F.Cu")
		(hatch edge 0.5)
		(min_thickness 0.25)
		(fill yes)
		(polygon (pts (xy 111 110.5) (xy 149 110.5) (xy 149 139.5) (xy 111 139.5)))
		(filled_polygon (layer "F.Cu") (pts (xy 111 110.5) (xy 149 110.5) (xy 149 139.5) (xy 111 139.5) (xy 111 127.5) (xy 121 127.5) (xy 121 122.5) (xy 111 122.5)))
	)
	(gr_rect (start 95 100) (end 165 150) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
	(zone
		(net 1)
		(net_name "GND")
		(layer "B.Cu")
		(hatch edge 0.5)
		(min_thickness 0.25)
		(fill yes)
		(polygon (pts (xy 95 100) (xy 165 100) (xy 165 150) (xy 95 150)))
		(filled_polygon (layer "B.Cu") (pts (xy 95 100) (xy 165 100) (xy 165 150) (xy 95 150)))
	)
)
